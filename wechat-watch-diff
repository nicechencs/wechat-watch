#!/bin/bash
# Cheap WeChat change detector: capture screen, hash the LEFT chat list only.
# Prints UNCHANGED or CHANGED. Never sends the image to a model.
# List change does NOT start video. Video is only recorded when the RIGHT
# conversation pane is scrolling (scrollbar / rolling pixels in the thread crop).
# Crops exclude the compose box, left list (for video), and the dock.
# On CHANGED, write list region crops and OCR each slice (chi_sim+eng).
set -euo pipefail

DISPLAY_NUM="${DISPLAY:-:8}"
PERSIST="${WECHAT_PERSIST:-/home/box/.local/share/wechat-persist}"
STATE_DIR="${WECHAT_WATCH_DIR:-$PERSIST/watch}"
FULL="$STATE_DIR/full.png"
CROP="$STATE_DIR/list.png"
PREV="$STATE_DIR/list.prev.png"
PREV_HASH_FILE="$STATE_DIR/list.sha256"
REGIONS_DIR="$STATE_DIR/regions"
REGIONS_JSON="$STATE_DIR/regions.json"
THREAD="$STATE_DIR/thread.png"
THREAD_PREV="$STATE_DIR/thread.prev.png"
WINDOW_PNG="$STATE_DIR/window.png"
WINDOW_SHA="$STATE_DIR/window.sha256"
WINDOW_BOXES="$STATE_DIR/window.boxes"
IDENTITIES="$STATE_DIR/identities.json"
AVATARS_DIR="$STATE_DIR/avatars"
CLIPS_DIR="$STATE_DIR/clips"
PERSIST_FFMPEG="$PERSIST/bin/ffmpeg"
# Prefer persist tessdata (survives reset) over the apt default path.
export TESSDATA_PREFIX="${TESSDATA_PREFIX:-$PERSIST/tessdata}"
# Prefer the git-repo helper; fall back to persist copy.
REGIONS_PY=""
for cand in \
  "/home/box/wechat-watch/wechat-watch-regions" \
  "$PERSIST/wechat-watch-regions"
do
  if [ -f "$cand" ]; then
    REGIONS_PY="$cand"
    break
  fi
done
GC_SH=""
for cand in \
  "/home/box/wechat-watch/wechat-watch-gc" \
  "$PERSIST/wechat-watch-gc"
do
  if [ -x "$cand" ]; then
    GC_SH="$cand"
    break
  fi
done

# Left chat list. Excludes compose + dock.
# Defaults: maximized 1280x800. Live --window-png overrides if it succeeds.
CROP_W=440
CROP_H=700
CROP_X=70
CROP_Y=30

# Right conversation pane on 1280x800 WeChat 4.1 (divider at x=412,
# compose toolbar at y=742). Must stay above the blinking cursor / dock.
# x=414 (not 510) so incoming avatars + left-aligned bubbles are included.
# Video records THIS rectangle only — never the list, compose box, or dock.
THREAD_W=720
THREAD_H=660
THREAD_X=414
THREAD_Y=40

SCROLL_SECS="${WECHAT_SCROLL_SECS:-4}"
SCROLL_FPS="${WECHAT_SCROLL_FPS:-4}"

find_ffmpeg() {
  if [ -x "$PERSIST_FFMPEG" ]; then
    printf '%s\n' "$PERSIST_FFMPEG"
    return 0
  fi
  if command -v ffmpeg >/dev/null 2>&1; then
    command -v ffmpeg
    return 0
  fi
  return 1
}

FFMPEG=""
if ! FFMPEG=$(find_ffmpeg); then
  sudo -n env DEBIAN_FRONTEND=noninteractive apt-get install -y ffmpeg || true
  if ! FFMPEG=$(find_ffmpeg); then
    echo "ERROR: ffmpeg missing (no persist/bin/ffmpeg, no PATH ffmpeg, apt install failed)" >&2
    exit 1
  fi
fi

mkdir -p "$STATE_DIR"

run_gc() {
  if [ -n "${GC_SH}" ]; then
    WECHAT_WATCH_DIR="$STATE_DIR" "$GC_SH" >/dev/null 2>&1 || true
  fi
}

# Keep previous crops before replacing.
if [ -f "$CROP" ]; then
  cp -f "$CROP" "$PREV"
fi
HAD_PREV=0
if [ -f "$PREV" ]; then
  HAD_PREV=1
fi
if [ -f "$THREAD" ]; then
  cp -f "$THREAD" "$THREAD_PREV"
fi
HAD_PREV_THREAD=0
if [ -f "$THREAD_PREV" ]; then
  HAD_PREV_THREAD=1
fi

apply_list_thread() {
  local _list="$1"
  local _thread="$2"
  if printf '%s' "${_list:-}" | grep -Eq '^-?[0-9]+,-?[0-9]+,[1-9][0-9]*,[1-9][0-9]*$'; then
    IFS=',' read -r CROP_X CROP_Y CROP_W CROP_H <<EOF
$_list
EOF
  fi
  if printf '%s' "${_thread:-}" | grep -Eq '^-?[0-9]+,-?[0-9]+,[1-9][0-9]*,[1-9][0-9]*$'; then
    IFS=',' read -r THREAD_X THREAD_Y THREAD_W THREAD_H <<EOF
$_thread
EOF
  fi
}

"$FFMPEG" -hide_banner -loglevel error -y \
  -f x11grab -draw_mouse 0 -video_size 1280x800 -i "${DISPLAY_NUM}.0" \
  -frames:v 1 -update 1 "$FULL"

# win= only (no PNG): crop window.png from this same full grab.
WIN_XYWH=""
if [ -n "${REGIONS_PY}" ] && command -v python3 >/dev/null 2>&1; then
  _geom="$(python3 "$REGIONS_PY" --window-geom 2>/dev/null || true)"
  _win="$(printf '%s\n' "$_geom" | awk -F= '/^win=/{print $2; exit}')"
  if printf '%s' "${_win:-}" | grep -Eq '^-?[0-9]+,-?[0-9]+,[1-9][0-9]*,[1-9][0-9]*$'; then
    WIN_XYWH="$_win"
  fi
  unset _geom _win
fi

if [ -n "$WIN_XYWH" ]; then
  IFS=',' read -r _wx _wy _ww _wh <<EOF
$WIN_XYWH
EOF
  if [ "$_wx" = "0" ] && [ "$_wy" = "0" ] && [ "$_ww" = "1280" ] && [ "$_wh" = "800" ]; then
    cp -f "$FULL" "$WINDOW_PNG" || true
  else
    "$FFMPEG" -hide_banner -loglevel error -y \
      -i "$FULL" -filter:v "crop=${_ww}:${_wh}:${_wx}:${_wy}" "$WINDOW_PNG" || true
  fi
  unset _wx _wy _ww _wh
fi

# Reuse last list=/thread= when window.png hash and win= geom are unchanged.
if [ -n "$WIN_XYWH" ] && [ -s "$WINDOW_PNG" ] && [ -n "${REGIONS_PY}" ] && command -v python3 >/dev/null 2>&1; then
  _win_hash="$(sha256sum "$WINDOW_PNG" | awk '{print $1}')"
  _cache_hit=0
  if [ -f "$WINDOW_SHA" ] && [ -f "$WINDOW_BOXES" ]; then
    _old_hash="$(tr -d '[:space:]' < "$WINDOW_SHA")"
    _old_win="$(awk -F= '/^win=/{print $2; exit}' "$WINDOW_BOXES")"
    if [ -n "$_win_hash" ] && [ "$_win_hash" = "$_old_hash" ] && [ "$WIN_XYWH" = "$_old_win" ]; then
      _list="$(awk -F= '/^list=/{print $2; exit}' "$WINDOW_BOXES")"
      _thread="$(awk -F= '/^thread=/{print $2; exit}' "$WINDOW_BOXES")"
      apply_list_thread "${_list:-}" "${_thread:-}"
      _cache_hit=1
    fi
  fi
  if [ "$_cache_hit" -eq 0 ]; then
    _geom="$(
      python3 "$REGIONS_PY" --window-geom --window-png "$WINDOW_PNG" --ffmpeg "$FFMPEG" 2>/dev/null || true
    )"
    if [ -n "${_geom}" ]; then
      _list="$(printf '%s\n' "$_geom" | awk -F= '/^list=/{print $2; exit}')"
      _thread="$(printf '%s\n' "$_geom" | awk -F= '/^thread=/{print $2; exit}')"
      apply_list_thread "${_list:-}" "${_thread:-}"
      {
        echo "win=$WIN_XYWH"
        echo "list=${_list:-}"
        echo "thread=${_thread:-}"
      } > "$WINDOW_BOXES"
      printf '%s\n' "$_win_hash" > "$WINDOW_SHA"
    fi
  fi
  unset _win_hash _cache_hit _old_hash _old_win _list _thread _geom
fi

"$FFMPEG" -hide_banner -loglevel error -y \
  -i "$FULL" -filter:v "crop=${CROP_W}:${CROP_H}:${CROP_X}:${CROP_Y}" "$CROP"

# Always refresh the thread still (cheap). Used only for scroll detect,
# never as the UNCHANGED/CHANGED decision.
"$FFMPEG" -hide_banner -loglevel error -y \
  -i "$FULL" -filter:v "crop=${THREAD_W}:${THREAD_H}:${THREAD_X}:${THREAD_Y}" "$THREAD"

HASH=$(sha256sum "$CROP" | awk '{print $1}')
NOW=$(date -Is)

# Cheap live-unread: LEFT chat list hash only.
LIST_CHANGED=1
if [ -f "$PREV_HASH_FILE" ]; then
  OLD=$(cat "$PREV_HASH_FILE")
  if [ "$HASH" = "$OLD" ]; then
    LIST_CHANGED=0
  fi
fi

emit_full_list() {
  mkdir -p "$REGIONS_DIR"
  if [ -n "$REGIONS_PY" ] && command -v python3 >/dev/null 2>&1; then
    if WECHAT_FFMPEG="$FFMPEG" python3 "$REGIONS_PY" \
      --full "$CROP" \
      --out-dir "$REGIONS_DIR" \
      --json "$REGIONS_JSON" \
      --ffmpeg "$FFMPEG"
    then
      return 0
    fi
    echo "WARNING: full-region OCR helper failed; emitting path only" >&2
  fi
  python3 - "$REGIONS_JSON" "$CROP" "$CROP_W" "$CROP_H" << 'PY'
import json, sys
json_path, crop, w, h = sys.argv[1], sys.argv[2], int(sys.argv[3]), int(sys.argv[4])
recs = [{"x": 0, "y": 0, "w": w, "h": h, "path": crop, "text": "", "kind": "image"}]
with open(json_path, "w", encoding="utf-8") as f:
    json.dump(recs, f, indent=2)
    f.write("\n")
PY
  echo "regions=1"
  echo "region=$CROP"
  echo "kind0=image"
}

emit_list_diff() {
  if [ -z "$REGIONS_PY" ] || ! command -v python3 >/dev/null 2>&1; then
    echo "WARNING: region helper or python3 missing; falling back to full crop" >&2
    emit_full_list
    return 0
  fi
  if ! WECHAT_FFMPEG="$FFMPEG" python3 "$REGIONS_PY" \
    --prev "$PREV" \
    --curr "$CROP" \
    --out-dir "$REGIONS_DIR" \
    --json "$REGIONS_JSON" \
    --ffmpeg "$FFMPEG"
  then
    echo "WARNING: region helper failed; falling back to full crop" >&2
    emit_full_list
    return 0
  fi
}

# Record ONLY the scrollable thread rectangle, and ONLY when it is scrolling.
# List change (unread / switching chats) never starts video.
maybe_record_scroll() {
  local list_changed="$1"
  if [ -z "$REGIONS_PY" ] || ! command -v python3 >/dev/null 2>&1; then
    return 0
  fi
  # Gate first: list change must not start video, even if the thread looks busy.
  local gate
  gate="$(
    python3 "$REGIONS_PY" --should-record \
      --list-changed "$list_changed" --scrolling 1 2>/dev/null || true
  )"
  if [ "${gate:-}" != "record=1" ]; then
    return 0
  fi
  if [ "$HAD_PREV_THREAD" -eq 0 ] || [ ! -f "$THREAD_PREV" ] || [ ! -f "$THREAD" ]; then
    return 0
  fi
  # Thread still identical → not scrolling (skip the pixel pass).
  if cmp -s "$THREAD" "$THREAD_PREV"; then
    return 0
  fi
  local info scrolling
  info="$(
    WECHAT_FFMPEG="$FFMPEG" python3 "$REGIONS_PY" \
      --detect-scroll --prev "$THREAD_PREV" --curr "$THREAD" --ffmpeg "$FFMPEG" \
      2>/dev/null || true
  )"
  scrolling="$(printf '%s\n' "$info" | awk -F= '/^scrolling=/{print $2; exit}')"
  if [ "${scrolling:-0}" != "1" ]; then
    return 0
  fi

  mkdir -p "$CLIPS_DIR" "$AVATARS_DIR"
  local stamp clip frames timeline
  stamp="$(date +%Y%m%dT%H%M%S)"
  clip="$CLIPS_DIR/scroll-${stamp}.mp4"
  frames="$CLIPS_DIR/scroll-${stamp}.frames"
  timeline="$CLIPS_DIR/scroll-${stamp}.json"

  # x11grab the thread crop only (exclude list / compose / dock).
  if ! "$FFMPEG" -hide_banner -loglevel error -y \
    -f x11grab -draw_mouse 0 \
    -video_size "${THREAD_W}x${THREAD_H}" \
    -framerate "$SCROLL_FPS" \
    -i "${DISPLAY_NUM}.0+${THREAD_X},${THREAD_Y}" \
    -t "$SCROLL_SECS" \
    -an -c:v libx264 -pix_fmt yuv420p \
    "$clip"
  then
    echo "WARNING: thread scroll x11grab failed" >&2
    rm -f "$clip"
    return 0
  fi
  if [ ! -s "$clip" ]; then
    rm -f "$clip"
    return 0
  fi

  mkdir -p "$frames"
  if ! "$FFMPEG" -hide_banner -loglevel error -y \
    -i "$clip" "$frames/f%04d.png"
  then
    echo "WARNING: clip frame extract failed" >&2
    return 0
  fi

  local parsed
  parsed="$(
    WECHAT_FFMPEG="$FFMPEG" python3 "$REGIONS_PY" \
      --parse-frames "$frames" \
      --timeline "$timeline" \
      --identities "$IDENTITIES" \
      --avatars-dir "$AVATARS_DIR" \
      --ffmpeg "$FFMPEG" \
      --fps "$SCROLL_FPS" \
      2>/dev/null || true
  )"
  echo "scroll=1"
  if [ -n "$parsed" ]; then
    printf '%s\n' "$parsed"
  else
    echo "timeline=$timeline"
  fi
  echo "$NOW scroll $timeline" >> "$STATE_DIR/changes.log"
}

if [ "$LIST_CHANGED" -eq 0 ]; then
  echo "UNCHANGED"
  echo "hash=$HASH"
  echo "at=$NOW"
  maybe_record_scroll 0
  run_gc
  exit 0
fi

echo "$HASH" > "$PREV_HASH_FILE"
echo "$NOW $HASH" >> "$STATE_DIR/changes.log"
echo "CHANGED"
echo "hash=$HASH"
echo "at=$NOW"
echo "list=$CROP"

if [ "$HAD_PREV" -eq 0 ]; then
  emit_full_list
else
  emit_list_diff
fi

# List change is the unread signal. It must not start video.
run_gc
exit 0
