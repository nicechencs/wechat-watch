def _median_int(vals: list[int]) -> int:
    if not vals:
        return 245
    vals.sort()
    return vals[len(vals) // 2]


def estimate_background_rgb(rgb: bytes, w: int, h: int) -> tuple[int, int, int]:
    """Median RGB from corners + 1-px border (chat canvas, not the bubble)."""
    if w <= 0 or h <= 0 or not rgb:
        return (245, 245, 245)
    rs: list[int] = []
    gs: list[int] = []
    bs: list[int] = []

    def take(x: int, y: int) -> None:
        i = (y * w + x) * 3
        rs.append(rgb[i])
        gs.append(rgb[i + 1])
        bs.append(rgb[i + 2])

    cw = min(6, w)
    ch = min(6, h)
    for y0 in (0, max(0, h - ch)):
        for yy in range(y0, min(h, y0 + ch)):
            for x0 in (0, max(0, w - cw)):
                for xx in range(x0, min(w, x0 + cw)):
                    take(xx, yy)
    for x in range(w):
        take(x, 0)
        if h > 1:
            take(x, h - 1)
    for y in range(h):
        take(0, y)
        if w > 1:
            take(w - 1, y)
    return (_median_int(rs), _median_int(gs), _median_int(bs))


def _image_at(when: datetime | str | None) -> str:
    if when is None:
        return datetime.now(timezone.utc).isoformat()
    if isinstance(when, datetime):
        if when.tzinfo is None:
            when = when.replace(tzinfo=timezone.utc)
        return when.isoformat()
    return str(when)


def detect_image_boxes(rgb: bytes, w: int, h: int) -> list[tuple[int, int, int, int]]:
    """Large nearly-uniform or photo-like rectangles that are not the canvas.

    Avatars (~40px), dots, and thin scrollbar strips are dropped. A large
    solid-color block on a light chat background is kept. The full blank
    frame is not.
    """
    if w <= 0 or h <= 0 or not rgb:
        return []
    br, bg, bb = estimate_background_rgb(rgb, w, h)
    n = w * h
    mask = bytearray(n)
    for i in range(n):
        o = i * 3
        if (
            abs(rgb[o] - br) > THRESH
            or abs(rgb[o + 1] - bg) > THRESH
            or abs(rgb[o + 2] - bb) > THRESH
        ):
            mask[i] = 1
    kept = denoise(mask, w, h)
    boxes = merge_boxes(components(kept, w, h), IMAGE_MERGE_GAP)
    out: list[tuple[int, int, int, int]] = []
    frame_area = float(w * h)
    for box in boxes:
        _x, _y, bw, bh = box
        if bw < IMAGE_MIN_SIDE or bh < IMAGE_MIN_SIDE:
            continue
        if bw * bh < IMAGE_MIN_AREA:
            continue
        if frame_area and (bw * bh) > IMAGE_MAX_FRAME_FRAC * frame_area:
            continue
        if bw >= int(w * 0.92) and bh >= int(h * 0.92):
            continue
        shorter = min(bw, bh)
        longer = max(bw, bh)
        if shorter > 0 and longer / shorter > IMAGE_MAX_ASPECT:
            continue
        if bw <= SCROLLBAR_STRIP + 6 and _x >= w - SCROLLBAR_STRIP - 10:
            continue
        out.append(pad_box(box, w, h, IMAGE_PAD))
    out.sort(key=lambda b: (b[1], b[0]))
    return out


def luma_at(rgb: bytes, w: int, x: int, y: int) -> int:
    o = (y * w + x) * 3
    return (rgb[o] * 30 + rgb[o + 1] * 59 + rgb[o + 2] * 11) // 100


def gradient_mask(
    rgb: bytes, w: int, h: int, min_grad: int = GRAD_MIN
) -> bytearray:
    """|dx|+|dy| luma gradient; mask[i]=1 if grad >= min_grad (UIED-style edges)."""
    n = w * h
    mask = bytearray(n)
    if w <= 0 or h <= 0 or not rgb:
        return mask
    for y in range(h):
        row = y * w
        y2 = y if y == h - 1 else y + 1
        for x in range(w):
            x2 = x if x == w - 1 else x + 1
            c = luma_at(rgb, w, x, y)
            dx = abs(luma_at(rgb, w, x2, y) - c)
            dy = abs(luma_at(rgb, w, x, y2) - c)
            if dx + dy >= min_grad:
                mask[row + x] = 1
    return mask


def majority3(mask: bytearray, w: int, h: int) -> bytearray:
    """3x3 majority: pixel stays on if >=5 of 9 neighbors (including self) are on."""
    out = bytearray(w * h)
    for y in range(h):
        y0 = 0 if y == 0 else y - 1
        y1 = h - 1 if y == h - 1 else y + 1
        row = y * w
        for x in range(w):
            x0 = 0 if x == 0 else x - 1
            x1 = w - 1 if x == w - 1 else x + 1
            on = 0
            for ny in range(y0, y1 + 1):
                nrow = ny * w
                for nx in range(x0, x1 + 1):
                    on += mask[nrow + nx]
            if on >= 5:
                out[row + x] = 1
    return out


def rm_line(mask: bytearray, w: int, h: int) -> bytearray:
    """Zero thin rows/cols that are mostly on (scrollbars, date dividers, gutters)."""
    out = bytearray(mask)
    if w <= 0 or h <= 0:
        return out
    row_mark = [False] * h
    for y in range(h):
        on = 0
        row = y * w
        for x in range(w):
            on += mask[row + x]
        if on / w > LINE_RATIO:
            row_mark[y] = True
    y = 0
    while y < h:
        if not row_mark[y]:
            y += 1
            continue
        y1 = y + 1
        while y1 < h and row_mark[y1]:
            y1 += 1
        if y1 - y <= LINE_THICK:
            for yy in range(y, y1):
                row = yy * w
                for x in range(w):
                    out[row + x] = 0
        y = y1
    col_mark = [False] * w
    for x in range(w):
        on = 0
        for y in range(h):
            on += out[y * w + x]
        if on / h > LINE_RATIO:
            col_mark[x] = True
    x = 0
    while x < w:
        if not col_mark[x]:
            x += 1
            continue
        x1 = x + 1
        while x1 < w and col_mark[x1]:
            x1 += 1
        if x1 - x <= LINE_THICK:
            for xx in range(x, x1):
                for y in range(h):
                    out[y * w + xx] = 0
        x = x1
    return out


def _is_line_box(box: tuple[int, int, int, int], w: int, h: int) -> bool:
    _x, _y, bw, bh = box
    if bw <= 0 or bh <= 0:
        return False
    shorter = min(bw, bh)
    longer = max(bw, bh)
    if shorter <= LINE_THICK + 2 and longer / max(1, shorter) >= CLASSIFY_LINE_ASPECT:
        return True
    bar = max(8, LINE_THICK * 2)
    if w > 0 and bw >= 0.7 * w and bh <= bar:
        return True
    if h > 0 and bh >= 0.7 * h and bw <= bar:
        return True
    return False


def _box_iou(
    a: tuple[int, int, int, int], b: tuple[int, int, int, int]
) -> float:
    ax, ay, aw, ah = a
    bx, by, bw, bh = b
    x1 = max(ax, bx)
    y1 = max(ay, by)
    x2 = min(ax + aw, bx + bw)
    y2 = min(ay + ah, by + bh)
    if x2 <= x1 or y2 <= y1:
        return 0.0
    inter = (x2 - x1) * (y2 - y1)
    union = aw * ah + bw * bh - inter
    return inter / union if union else 0.0


def _filter_classify_boxes(
    boxes: list[tuple[int, int, int, int]], w: int, h: int
) -> list[tuple[int, int, int, int]]:
    frame_area = float(w * h) if w and h else 1.0
    out: list[tuple[int, int, int, int]] = []
    for box in boxes:
        _x, _y, bw, bh = box
        if bw * bh < CLASSIFY_MIN_AREA:
            continue
        if h > 0 and bh > CLASSIFY_MAX_H_FRAC * h:
            continue
        if bw >= int(w * 0.92) and bh >= int(h * 0.92):
            continue
        if (bw * bh) > 0.85 * frame_area:
            continue
        shorter = min(bw, bh)
        longer = max(bw, bh)
        if shorter > 0 and longer / shorter > CLASSIFY_MAX_ASPECT:
            continue
        out.append(box)
    return out


def _box_stats(
    rgb: bytes,
    w: int,
    h: int,
    box: tuple[int, int, int, int],
    bg: tuple[int, int, int],
) -> tuple[float, tuple[int, int, int], float, int]:
    """Return (luma_var, mean_rgb, fill_vs_bg, n)."""
    x, y, bw, bh = box
    x0 = max(0, x)
    y0 = max(0, y)
    x1 = min(w, x + bw)
    y1 = min(h, y + bh)
    br, bgc, bb = bg
    n = 0
    s = 0
    s2 = 0
    tr = tg = tb = 0
    fill = 0
    for yy in range(y0, y1):
        row = yy * w * 3
        for xx in range(x0, x1):
            o = row + xx * 3
            r, g, b = rgb[o], rgb[o + 1], rgb[o + 2]
            lum = (r * 30 + g * 59 + b * 11) // 100
            s += lum
            s2 += lum * lum
            tr += r
            tg += g
            tb += b
            if (
                abs(r - br) > THRESH
                or abs(g - bgc) > THRESH
                or abs(b - bb) > THRESH
            ):
                fill += 1
            n += 1
    if n <= 0:
        return 0.0, (0, 0, 0), 0.0, 0
    mean = s / n
    var = s2 / n - mean * mean
    if var < 0:
        var = 0.0
    return var, (tr // n, tg // n, tb // n), fill / n, n


def _nested_children(
    rgb: bytes, w: int, h: int, box: tuple[int, int, int, int]
) -> list[tuple[int, int, int, int]]:
    """Smaller rectangles inside a large box (UIED nested inspect)."""
    x, y, bw, bh = box
    inset = NEST_INSET
    if bw < 2 * inset + 16 or bh < 2 * inset + 16:
        return []
    ix = x + inset
    iy = y + inset
    iw = bw - 2 * inset
    ih = bh - 2 * inset
    if iw <= 0 or ih <= 0:
        return []
    tr = tg = tb = 0
    n = 0
    x1 = min(w, ix + iw)
    y1 = min(h, iy + ih)
    ix = max(0, ix)
    iy = max(0, iy)
    iw = x1 - ix
    ih = y1 - iy
    if iw <= 0 or ih <= 0:
        return []
    for yy in range(iy, y1):
        row = yy * w * 3
        for xx in range(ix, x1):
            o = row + xx * 3
            tr += rgb[o]
            tg += rgb[o + 1]
            tb += rgb[o + 2]
            n += 1
    if n <= 0:
        return []
    dr, dg, db = tr // n, tg // n, tb // n
    local = bytearray(iw * ih)
    nest_grad = GRAD_MIN + 6
    for yy in range(iy, y1):
        ly = yy - iy
        for xx in range(ix, x1):
            o = (yy * w + xx) * 3
            r, g, b = rgb[o], rgb[o + 1], rgb[o + 2]
            color_hit = (
                abs(r - dr) > NEST_COLOR_DELTA
                or abs(g - dg) > NEST_COLOR_DELTA
                or abs(b - db) > NEST_COLOR_DELTA
            )
            grad_hit = False
            if not color_hit:
                c = (r * 30 + g * 59 + b * 11) // 100
                x2 = xx if xx >= w - 1 else xx + 1
                y2 = yy if yy >= h - 1 else yy + 1
                dx = abs(luma_at(rgb, w, x2, yy) - c)
                dy = abs(luma_at(rgb, w, xx, y2) - c)
                grad_hit = (dx + dy) >= nest_grad
            if color_hit or grad_hit:
                local[ly * iw + (xx - ix)] = 1
    local = denoise(local, iw, ih)
    kids = merge_boxes(components(local, iw, ih), 8)
    parent_area = bw * bh
    out: list[tuple[int, int, int, int]] = []
    for kx, ky, kw, kh in kids:
        if kw < NEST_CHILD_MIN_SIDE or kh < NEST_CHILD_MIN_SIDE:
            continue
        if kw * kh < CLASSIFY_MIN_AREA:
            continue
        if kw * kh > 0.85 * parent_area:
            continue
        shorter = min(kw, kh)
        longer = max(kw, kh)
        if shorter > 0 and longer / shorter > CLASSIFY_MAX_ASPECT:
            continue
        out.append((kx + ix, ky + iy, kw, kh))
    return out


def _split_nested(
    rgb: bytes,
    w: int,
    h: int,
    box: tuple[int, int, int, int],
    depth: int = 0,
) -> list[tuple[int, int, int, int]]:
    _x, _y, _bw, bh = box
    if depth >= 2 or bh < NEST_MIN_H:
        return [box]
    kids = _nested_children(rgb, w, h, box)
    if len(kids) < 2:
        return [box]
    out: list[tuple[int, int, int, int]] = []
    for kid in kids:
        out.extend(_split_nested(rgb, w, h, kid, depth + 1))
    return out


def classify_region(
    rgb: bytes, w: int, h: int, box: tuple[int, int, int, int]
) -> str:
    """Pixel-first kind in {image, text, line, chrome}. No OCR."""
    _x, _y, bw, bh = box
    if bw <= 0 or bh <= 0 or w <= 0 or h <= 0 or not rgb:
        return "chrome"
    if _is_line_box(box, w, h):
        return "line"
    if bw >= int(w * 0.92) and bh >= int(h * 0.92):
        return "chrome"
    bg = estimate_background_rgb(rgb, w, h)
    var, mean_rgb, fill, n = _box_stats(rgb, w, h, box, bg)
    if n <= 0:
        return "chrome"
    size_ok = (
        bw >= IMAGE_MIN_SIDE
        and bh >= IMAGE_MIN_SIDE
        and bw * bh >= IMAGE_MIN_AREA
    )
    br, bgc, bb = bg
    mr, mg, mb = mean_rgb
    not_bg = (
        abs(mr - br) > THRESH
        or abs(mg - bgc) > THRESH
        or abs(mb - bb) > THRESH
    )
    solid = var <= CLASSIFY_SOLID_VAR
    photo = var > CLASSIFY_VAR_HIGH and fill >= CLASSIFY_FILL_IMAGE
    if size_ok and (photo or (not_bg and (solid or fill >= CLASSIFY_FILL_IMAGE))):
        return "image"
    if bw < IMAGE_MIN_SIDE and bh < IMAGE_MIN_SIDE:
        return "chrome"
    if max(bw, bh) <= 48:
        return "chrome"
    if bw * bh < CLASSIFY_MIN_AREA:
        return "chrome"
    return "text"


def detect_and_classify(rgb: bytes, w: int, h: int) -> list[dict]:
    """UIED-inspired boxes: gradient → denoise → rm_line → nest → classify.

    Returns list of {kind, box:(x,y,w,h)} sorted by (y, x). OCR is not run.
    """
    if w <= 0 or h <= 0 or not rgb:
        return []
    mask = gradient_mask(rgb, w, h)
    br, bg, bb = estimate_background_rgb(rgb, w, h)
    n = w * h
    for i in range(n):
        if mask[i]:
            continue
        o = i * 3
        if (
            abs(rgb[o] - br) > THRESH
            or abs(rgb[o + 1] - bg) > THRESH
            or abs(rgb[o + 2] - bb) > THRESH
        ):
            mask[i] = 1
    mask = denoise(mask, w, h)
    mask = majority3(mask, w, h)
    pre = bytearray(mask)
    cleaned = rm_line(mask, w, h)
    content = merge_boxes(components(cleaned, w, h), MERGE_GAP)
    content = _filter_classify_boxes(content, w, h)
    split: list[tuple[int, int, int, int]] = []
    for box in content:
        split.extend(_split_nested(rgb, w, h, box))
    split = _filter_classify_boxes(split, w, h)

    recs: list[dict] = []
    for box in split:
        recs.append({"kind": classify_region(rgb, w, h, box), "box": box})

    line_mask = bytearray(n)
    for i in range(n):
        if pre[i] and not cleaned[i]:
            line_mask[i] = 1
    line_boxes = merge_boxes(components(line_mask, w, h), 4)
    for box in merge_boxes(components(pre, w, h), MERGE_GAP):
        if _is_line_box(box, w, h):
            line_boxes.append(box)
    for box in line_boxes:
        if not _is_line_box(box, w, h) and classify_region(rgb, w, h, box) != "line":
            continue
        if any(_box_iou(box, rec["box"]) > 0.4 for rec in recs):
            continue
        recs.append({"kind": "line", "box": box})

    recs.sort(key=lambda rec: (rec["box"][1], rec["box"][0]))
    return recs


# WeChat thread time/date divider chips (centered gray: 今天 16:04 / 昨天 / 年月日).
_HHMM = r"(\d{1,2})\s*[:：.]\s*(\d{2})"
_HHMM_RE = re.compile(r"(?<!\d)" + _HHMM + r"(?!\d)")
TIME_DIVIDER_RE = re.compile(
    r"(?:"
    r"刚刚|"
    r"just\s*now|"
    r"今天|"
    r"昨天|"
    r"today|"
    r"yesterday|"
    r"星期[一二三四五六日天]|"
    r"(?:\d{4}\s*年\s*)?\d{1,2}\s*月\s*\d{1,2}\s*日|"
    r"(?<!\d)\d{1,2}\s*[:：.]\s*\d{2}(?!\d)"
    r")",
    re.IGNORECASE,
)
_TIME_OCR_KEEP_RE = re.compile(
    r"刚刚|今天|昨天|today|yesterday|just\s*now|"
    r"(?<!\d)\d{1,2}\s*[:：.]\s*\d{2}(?!\d)",
    re.IGNORECASE,
)
TIME_CHIP_MAX_H = 48
TIME_CHIP_MIN_W = 40
TIME_CHIP_MAX_W_FRAC = 0.85
TIME_CHIP_CENTER_FRAC = 0.22
TIME_OCR_PAD = 6


def parse_time_divider(text: str) -> dict | None:
    """Parse OCR raw from a WeChat time/date divider chip.

    Always keeps the raw string when the text looks time-like. Does not
    require a perfect datetime (OCR may drop CJK).
    """
    raw = (text or "").strip()
    if not raw:
        return None
    if not TIME_DIVIDER_RE.search(raw):
        return None
    rec: dict = {"text": raw, "raw": raw}
    hm = _HHMM_RE.search(raw)
    if hm:
        rec["hh"] = int(hm.group(1))
        rec["mm"] = int(hm.group(2))
    low = raw.lower()
    if "刚刚" in raw or "just now" in low:
        rec["kind"] = "just_now"
    elif "今天" in raw or re.search(r"\btoday\b", low):
        rec["kind"] = "today"
    elif "昨天" in raw or re.search(r"\byesterday\b", low):
        rec["kind"] = "yesterday"
    elif "星期" in raw:
        rec["kind"] = "weekday"
    elif "月" in raw and "日" in raw:
        rec["kind"] = "date"
    elif hm:
        rec["kind"] = "clock"
    return rec


def _is_photo_block(box: tuple[int, int, int, int]) -> bool:
    _x, _y, bw, bh = box
    return (
        bw >= IMAGE_MIN_SIDE
        and bh >= IMAGE_MIN_SIDE
        and bw * bh >= IMAGE_MIN_AREA
    )


def _is_time_chip(box: tuple[int, int, int, int], w: int, h: int) -> bool:
    """Short centered chip, not a left/right bubble, not a large image."""
    x, _y, bw, bh = box
    if bw <= 0 or bh <= 0 or w <= 0 or h <= 0:
        return False
    if _is_photo_block(box):
        return False
    if bh > TIME_CHIP_MAX_H:
        return False
    if bw < TIME_CHIP_MIN_W or bw > TIME_CHIP_MAX_W_FRAC * w:
        return False
    mid = x + bw / 2.0
    if abs(mid - w / 2.0) > TIME_CHIP_CENTER_FRAC * w:
        return False
    frame_mid = w / 2.0
    spans_center = x < frame_mid < (x + bw)
    if x <= 0.08 * w and not spans_center:
        return False
    if (x + bw) >= 0.92 * w and not spans_center:
        return False
    return True


def _time_keep_ocr(text: str) -> bool:
    if parse_time_divider(text) is not None:
        return True
    return bool(text and _TIME_OCR_KEEP_RE.search(text))


def _extra_time_chip_boxes(
    rgb: bytes, w: int, h: int
) -> list[tuple[int, int, int, int]]:
    """Thin centered chips that classify / nest may have missed."""
    if w <= 0 or h <= 0 or not rgb:
        return []
    br, bg, bb = estimate_background_rgb(rgb, w, h)
    n = w * h
    mask = bytearray(n)
    for i in range(n):
        o = i * 3
        if (
            abs(rgb[o] - br) > THRESH
            or abs(rgb[o + 1] - bg) > THRESH
            or abs(rgb[o + 2] - bb) > THRESH
        ):
            mask[i] = 1
    mask = denoise(mask, w, h)
    boxes = merge_boxes(components(mask, w, h), MERGE_GAP)
    return [b for b in boxes if _is_time_chip(b, w, h)]


def _write_rgb24_png(
    ffmpeg: str, rgb: bytes, w: int, h: int, dest: str
) -> None:
    raw_path = dest + ".rgb"
    with open(raw_path, "wb") as fh:
        fh.write(rgb)
    cmd = [
        ffmpeg,
        "-hide_banner",
        "-loglevel",
        "error",
        "-y",
        "-f",
        "rawvideo",
        "-pix_fmt",
        "rgb24",
        "-s",
        f"{w}x{h}",
        "-i",
        raw_path,
        "-frames:v",
        "1",
        "-update",
        "1",
        dest,
    ]
    subprocess.run(cmd, check=True)


def _dedup_time_boxes(
    boxes: list[tuple[int, int, int, int]],
) -> list[tuple[int, int, int, int]]:
    ordered = sorted(boxes, key=lambda b: (b[1], b[0]))
    kept: list[tuple[int, int, int, int]] = []
    for box in ordered:
        if any(_box_iou(box, prev) > 0.4 for prev in kept):
            continue
        kept.append(box)
    return kept


def detect_time_dividers(
    thread_png: str | None = None,
    *,
    rgb: bytes | None = None,
    w: int = 0,
    h: int = 0,
    ffmpeg: str | None = None,
) -> list[dict]:
    """Pixel-first time/date divider chips; OCR only those thin boxes."""
    ff = resolve_ffmpeg(ffmpeg or default_ffmpeg())
    src_png = thread_png if thread_png and os.path.isfile(thread_png) else None
    with tempfile.TemporaryDirectory(prefix="wechat-watch-time-") as td:
        if src_png:
            w, h = png_size(src_png)
            if rgb is None:
                rgb = decode_rgb24(ff, src_png, w, h, os.path.join(td, "t.rgb"))
        if rgb is None or w <= 0 or h <= 0:
            return []
        classified = detect_and_classify(rgb, w, h)
        candidates: list[tuple[int, int, int, int]] = []
        for rec in classified:
            kind = rec.get("kind")
            box = rec["box"]
            if kind == "image":
                continue
            if _is_photo_block(box):
                continue
            if kind == "line":
                candidates.append(box)
            elif _is_time_chip(box, w, h):
                candidates.append(box)
        for box in _extra_time_chip_boxes(rgb, w, h):
            candidates.append(box)
        candidates = _dedup_time_boxes(candidates)
        if not src_png:
            src_png = os.path.join(td, "frame.png")
            try:
                _write_rgb24_png(ff, rgb, w, h, src_png)
            except (OSError, subprocess.CalledProcessError):
                return []
        recs: list[dict] = []
        for i, box in enumerate(candidates):
            crop_box = pad_box(box, w, h, TIME_OCR_PAD)
            crop = os.path.join(td, f"chip{i}.png")
            try:
                crop_png(ff, src_png, crop, crop_box)
            except (OSError, subprocess.CalledProcessError):
                continue
            text, _kind = ocr_png(crop, crop_box)
            text = (text or "").strip()
            if not _time_keep_ocr(text):
                continue
            x, y, bw, bh = (int(box[0]), int(box[1]), int(box[2]), int(box[3]))
            recs.append({"box": (x, y, bw, bh), "text": text, "kind": "time"})
        recs.sort(key=lambda rec: (rec["box"][1], rec["box"][0]))
        out: list[dict] = []
        for rec in recs:
            if any(_box_iou(rec["box"], prev["box"]) > 0.4 for prev in out):
                continue
            out.append(rec)
        return out


