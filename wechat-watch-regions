        recs = cache_images(
            args.cache_images,
            images_dir,
            ffmpeg,
            when=parse_when(args.when),
        )
        emit_images_stdout(recs)
        return 0

    if args.classify:
        if not os.path.isfile(args.classify):
            print(f"ERROR: thread png missing: {args.classify}", file=sys.stderr)
            return 2
        ffmpeg = resolve_ffmpeg(args.ffmpeg)
        w, h = png_size(args.classify)
        with tempfile.TemporaryDirectory(prefix="wechat-watch-cls-") as td:
            rgb = decode_rgb24(ffmpeg, args.classify, w, h, os.path.join(td, "t.rgb"))
        recs = detect_and_classify(rgb, w, h)
        print(f"regions={len(recs)}")
        for i, rec in enumerate(recs):
            x, y, bw, bh = rec["box"]
            print(f"kind{i}={rec['kind']}")
            print(f"box{i}={x},{y},{bw},{bh}")
        for rec in recs:
            print(f"kind={rec['kind']}")
        return 0

    if args.detect_time:
        if not os.path.isfile(args.detect_time):
            print(f"ERROR: thread png missing: {args.detect_time}", file=sys.stderr)
            return 2
        ffmpeg = resolve_ffmpeg(args.ffmpeg)
        recs = detect_time_dividers(args.detect_time, ffmpeg=ffmpeg)
        emit_times_stdout(recs)
        return 0

    if args.should_record:
        rec = should_record_scroll(bool(args.list_changed), bool(args.scrolling))
        print(f"record={1 if rec else 0}")
        return 0

    if args.detect_scroll:
        if not args.prev or not args.curr:
            p.error("--detect-scroll requires --prev and --curr")
        if not os.path.isfile(args.prev):
            print(f"ERROR: prev missing: {args.prev}", file=sys.stderr)
            return 2
        if not os.path.isfile(args.curr):
            print(f"ERROR: curr missing: {args.curr}", file=sys.stderr)
            return 2
        ffmpeg = resolve_ffmpeg(args.ffmpeg)
        info = detect_scroll(args.prev, args.curr, ffmpeg)
        print(f"scrolling={1 if info['scrolling'] else 0}")
        print(f"shift={info['shift']}")
        print(f"score={info['score']:.3f}")
        print(f"scrollbar={1 if info['scrollbar'] else 0}")
        print(f"changed_frac={info['changed_frac']:.3f}")
        td = info.get("thumb_delta")
        if td is None:
            print("thumb_delta=")
        else:
            print(f"thumb_delta={td:.1f}")
        return 0

    if args.parse_frames:
        if not os.path.isdir(args.parse_frames):
            print(f"ERROR: frames dir missing: {args.parse_frames}", file=sys.stderr)
            return 2
        ffmpeg = resolve_ffmpeg(args.ffmpeg)
        timeline_path = args.timeline or os.path.join(args.parse_frames, "timeline.json")
        persist = os.environ.get(
            "WECHAT_PERSIST", "/home/box/.local/share/wechat-persist"
        )
        identities_path = args.identities or os.path.join(
            persist, "watch", "identities.json"
        )
        avatars_dir = args.avatars_dir or os.path.join(persist, "watch", "avatars")
        recs = parse_frames_dir(
            args.parse_frames,
            ffmpeg,
            timeline_path,
            identities_path,
            avatars_dir,
            fps=args.fps,
        )
        print(f"messages={len(recs)}")
        print(f"timeline={timeline_path}")
        return 0

    if args.full:
        if not args.json:
            p.error("--json is required with --full")
        if not os.path.isfile(args.full):
            print(f"ERROR: full png missing: {args.full}", file=sys.stderr)
            return 2
        recs = annotate_full(args.full, args.json, emit_side=args.emit_side)
        emit_region_stdout(recs, label=args.label, emit_side=args.emit_side)
        return 0

    if not args.prev or not args.curr:
        p.error("--prev and --curr are required unless --full / --detect-scroll / --parse-frames / --should-record / --format-time / --ocr-still / --detect-unread / --detect-nav / --cache-images / --classify / --detect-time / --window-geom / --fingerprint / --fingerprint-json / --normalize-nick")
    if not args.out_dir or not args.json:
        p.error("--out-dir and --json are required unless --detect-scroll / --parse-frames / --should-record")

    if not os.path.isfile(args.prev):
        print(f"ERROR: prev missing: {args.prev}", file=sys.stderr)
        return 2
    if not os.path.isfile(args.curr):
        print(f"ERROR: curr missing: {args.curr}", file=sys.stderr)
        return 2
    ffmpeg = resolve_ffmpeg(args.ffmpeg)

    boxes, w, h, _n = compute_regions(args.prev, args.curr, ffmpeg)
    if not boxes:
        w, h = png_size(args.curr)
        boxes = [(0, 0, w, h)]
    recs = write_outputs(
        boxes,
        args.curr,
        args.out_dir,
        args.json,
        ffmpeg,
        prefix=args.prefix,
        extra_top_pad=args.extra_top_pad,
        emit_side=args.emit_side,
        frame_w=w,
    )
    emit_region_stdout(recs, label=args.label, emit_side=args.emit_side)
    return 0



