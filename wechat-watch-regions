        help="read-only: red badge / red dot / [N条] / @ / z on the left chat list",
    )
    p.add_argument(
        "--detect-nav",
        metavar="NAV.png",
        help="read-only: red badge / red dot on left-nav icons (by vertical slot)",
    )
    p.add_argument(
        "--cache-images",
        metavar="THREAD.png",
        help="read-only: crop image-like bubbles into persist/watch/images (never sent)",
    )
    p.add_argument(
        "--classify",
        metavar="THREAD.png",
