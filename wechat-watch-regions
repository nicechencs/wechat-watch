def cache_images(
    thread_png: str,
    images_dir: str,
    ffmpeg: str,
    when: datetime | str | None = None,
) -> list[dict]:
    """Crop image-like bubbles from a thread PNG into images_dir (hash-named).

    Pixel-first classify_region decides kind; OCR runs only for kind==text
    (and those are not cached). Idempotent: existing {hash}.png is reused.
    Sidecar {hash}.json is {hash, box, at}. Local persist only; never sent.
    """
    os.makedirs(images_dir, exist_ok=True)
    at = _image_at(when)
    w, h = png_size(thread_png)
    recs: list[dict] = []
    seen: set[str] = set()
    with tempfile.TemporaryDirectory(prefix="wechat-watch-img-") as td:
        rgb = decode_rgb24(ffmpeg, thread_png, w, h, os.path.join(td, "t.rgb"))
        boxes = detect_image_boxes(rgb, w, h)
        for i, box in enumerate(boxes):
            kind = classify_region(rgb, w, h, box)
            if kind != "image":
                continue
            crop = os.path.join(td, f"c{i}.png")
            try:
                crop_png(ffmpeg, thread_png, crop, box)
            except (OSError, subprocess.CalledProcessError):
                continue
            try:
                with open(crop, "rb") as fh:
                    digest = hashlib.sha256(fh.read()).hexdigest()
            except OSError:
                continue
            if digest in seen:
                continue
            seen.add(digest)
            dest = os.path.join(images_dir, f"{digest}.png")
            side = os.path.join(images_dir, f"{digest}.json")
            if not os.path.isfile(dest):
                try:
                    with open(crop, "rb") as src, open(dest, "wb") as dst:
                        dst.write(src.read())
                except OSError:
                    continue
            x, y, bw, bh = box
            box_obj = {"x": int(x), "y": int(y), "w": int(bw), "h": int(bh)}
            if not os.path.isfile(side):
                meta = {"hash": digest, "box": box_obj, "at": at}
                try:
                    with open(side, "w", encoding="utf-8") as fh:
                        json.dump(meta, fh, indent=2, ensure_ascii=False)
                        fh.write("\n")
                except OSError:
                    pass
            recs.append({"hash": digest, "path": dest, "box": box_obj, "at": at})
    return recs


def emit_images_stdout(recs: list[dict]) -> None:
    print(f"images={len(recs)}")
    for rec in recs:
        print(f"image={rec.get('path', '')}")


def default_ffmpeg() -> str:
    return os.environ.get(
        "WECHAT_FFMPEG",
        "/home/box/.local/share/wechat-persist/bin/ffmpeg",
    )


def resolve_ffmpeg(ffmpeg: str) -> str:
    if os.path.isfile(ffmpeg) and os.access(ffmpeg, os.X_OK):
        return ffmpeg
    return "ffmpeg"


