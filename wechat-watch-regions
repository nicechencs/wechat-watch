    if args.fingerprint is not None:
        print(list_text_fingerprint(args.fingerprint))
        return 0

    if args.fingerprint_json:
        print(list_text_fingerprint(list_text_from_json(args.fingerprint_json)))
        return 0

    if args.window_geom:
        win, source = find_window()
        rgb = None
        frame_w = frame_h = None
        if args.window_png:
            if not os.path.isfile(args.window_png):
                print(f"ERROR: window png missing: {args.window_png}", file=sys.stderr)
                return 2
            try:
                frame_w, frame_h = png_size(args.window_png)
                ffmpeg = resolve_ffmpeg(args.ffmpeg)
                with tempfile.TemporaryDirectory(prefix="wechat-watch-winpng-") as td:
                    rgb = decode_rgb24(
                        ffmpeg,
                        args.window_png,
                        frame_w,
                        frame_h,
                        os.path.join(td, "win.rgb"),
                    )
            except (OSError, ValueError, subprocess.CalledProcessError) as exc:
                print(f"ERROR: window png: {exc}", file=sys.stderr)
                return 2
        emit_window_geom(win, source, rgb=rgb, frame_w=frame_w, frame_h=frame_h)
        return 0

    if args.format_time:
        emit_summary_times(parse_when(args.when))
        return 0

    if args.ocr_still:
