#!/usr/bin/env python3
"""Region crops, OCR, scroll detect, and scroll-timeline parse.

Decode two PNGs to raw rgb24 via persist ffmpeg (no Pillow). Find bounding
boxes of changed pixels and write small crops plus regions.json so an agent
can Read only the slices that changed. After each rN.png, run tesseract
(chi_sim+eng) so CHANGED text regions emit plain text (no vision needed).

Scroll-history: detect rolling pixels / scrollbar in the thread crop, then
parse a frame sequence into a JSON timeline (t, side, name, avatar_hash, text).
Incoming avatars are average-hashed and bound to OCR'd nicknames in
identities.json.

Usage:
  wechat-watch-regions --prev PREV.png --curr CURR.png \\
      --out-dir REGIONS_DIR --json OUT.json [--ffmpeg PATH]
  wechat-watch-regions --full LIST.png --out-dir REGIONS_DIR --json OUT.json
  wechat-watch-regions ... --prefix t --label thread_ --emit-side
  wechat-watch-regions --detect-scroll --prev thread.prev.png --curr thread.png
  wechat-watch-regions --parse-frames FRAMES_DIR --timeline OUT.json \\
      --identities identities.json --avatars-dir avatars/
  wechat-watch-regions --format-time [--when ISO8601]
  wechat-watch-regions --ocr-still THREAD.png [--json OUT.json] [--when ISO8601]
  wechat-watch-regions --detect-unread LIST.png   # red badge / dot / [N条] (read-only)
  wechat-watch-regions --detect-nav NAV.png       # left-nav icon badges (read-only)
  wechat-watch-regions --cache-images THREAD.png [--images-dir DIR]
      # read-only image-bubble crops; local persist only, never sent
  wechat-watch-regions --classify THREAD.png
  wechat-watch-regions --detect-time THREAD.png
  wechat-watch-regions --window-geom [--window-png WIN.png]
      # win/nav/list/thread + source= + id=; PNG scans gutters inside the window
  wechat-watch-regions --fingerprint TEXT
  wechat-watch-regions --fingerprint-json regions.json
  wechat-watch-regions --normalize-nick RAW
      # print nick= and ok=0|1; no PNG
"""
