        "--detect-time",
        metavar="THREAD.png",
        help="read-only: centered time/date divider chips (今天 16:04 / 昨天 / 年月日)",
    )
    p.add_argument(
        "--images-dir",
        help="hashed image crops (default: $WECHAT_PERSIST/watch/images)",
    )
