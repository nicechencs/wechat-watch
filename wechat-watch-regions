def _nav_icon_box(y_frac: float, w: int, h: int) -> tuple[int, int, int, int]:
    side = min(NAV_ICON_SIDE, max(1, w), max(1, h))
    cx = w // 2
    cy = int(round(y_frac * h))
    x = max(0, min(w - side, cx - side // 2))
    y = max(0, min(h - side, cy - side // 2))
    return (x, y, min(side, w - x), min(side, h - y))


def _nearest_nav_slot(cy: float, h: int) -> int:
    best_i = 0
    best_d = abs(NAV_SLOTS[0][1] * h - cy)
    for i, (_sid, y_frac) in enumerate(NAV_SLOTS[1:], start=1):
        d = abs(y_frac * h - cy)
        if d < best_d:
            best_d = d
            best_i = i
    return best_i


def detect_nav(path: str, ffmpeg: str) -> list[dict]:
    """Read-only: red number / red dot on left-nav icons, mapped by vertical slot."""
    w, h = png_size(path)
    with tempfile.TemporaryDirectory(prefix="wechat-watch-nav-") as td:
        src = path
        crop_box = nav_source_box(w, h)
        if crop_box is not None:
            src = os.path.join(td, "nav-crop.png")
            crop_png(ffmpeg, path, src, crop_box)
            w, h = crop_box[2], crop_box[3]
        rgb = decode_rgb24(ffmpeg, src, w, h, os.path.join(td, "nav.rgb"))
        assigned: list[tuple[int, int, int, int] | None] = [None] * len(NAV_SLOTS)
        counts = [0] * len(NAV_SLOTS)
        for x, y, bw, bh, _n in red_clusters(rgb, w, h):
            box = (x, y, bw, bh)
            idx = _nearest_nav_slot(y + bh / 2.0, h)
            count = ocr_badge_count(ffmpeg, src, box, w, h, td)
            prev = assigned[idx]
            if prev is None or (count > 0 and counts[idx] == 0):
                assigned[idx] = box
                counts[idx] = count
        recs: list[dict] = []
        for i, (sid, y_frac) in enumerate(NAV_SLOTS):
            box = assigned[i] if assigned[i] is not None else _nav_icon_box(y_frac, w, h)
            count = counts[i]
            if assigned[i] is None:
                badge = "none"
            elif count > 0:
                badge = "number"
            else:
                badge = "dot"
            x, y, bw, bh = box
            recs.append(
                {
                    "id": sid,
                    "name": sid,
                    "badge": badge,
                    "count": int(count or 0),
                    "x": int(x),
                    "y": int(y),
                    "w": int(bw),
                    "h": int(bh),
                }
            )
    return recs


